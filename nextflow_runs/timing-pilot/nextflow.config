// Sherlock settings for main.nf. Launched by `make run`; every path below is what
// ../nf-core-proteinannotator staged (`make sherlock-stage` there) or `make stage` here.

def scratch = System.getenv('SCRATCH') ?: "${System.getenv('HOME')}/scratch"
def home    = System.getenv('HOME')

params {
    pilot_dir   = "${scratch}/botryllus-annotation-timing-pilot"
    pa_db_dir   = "${scratch}/botryllus-mhc-proteinannotator/dbs"
    ips_version = '5.59-91.0'
    ips_tarball = "${params.pa_db_dir}/interproscan-${params.ips_version}-64-bit.tar.gz"
    // Where the unpacked data is kept. A stub test points this elsewhere so it cannot leave
    // an empty folder where the real data belongs.
    ips_store_dir = params.pa_db_dir
    pa_img_dir  = "${scratch}/singularity-cache/proteinannotator"
    pa_config   = "${projectDir}/../nf-core-proteinannotator/sherlock.config"
    pipeline_commit = 'c70cd5849c80b5b1b7477a451a03ad108eb4191a'
    nextflow_bin = "${home}/software/nextflow/25.10.4/nextflow"
    java_home   = '/share/software/user/open/java/18.0.2'
    // Every member database InterProScan 5.59 lists as available (`interproscan.sh --help`
    // with the data mounted, 2026-10-27). UniFIRE uses hits from all of them, so InterProScan
    // runs once, here. SignalP, TMHMM and Phobius need licences and are not in the image.
    interproscan_apps = 'AntiFam,CDD,Coils,FunFam,Gene3D,Hamap,MobiDBLite,PANTHER,Pfam,PIRSF,PIRSR,PRINTS,ProSitePatterns,ProSiteProfiles,SFLD,SMART,SUPERFAMILY,TIGRFAM'
    // 100 per batch gives 5 batches, so per-batch times can be compared
    interproscan_batch_size = 100
    // full.config: a second -c file for the nested proteinannotator run, and no ESMFold
    pa_extra_config = null
    pa_extra_args   = ''
    skip_fold = false

    fasta    = "${projectDir}/botryllus_pilot500.fasta"
    fasta_ox = "${projectDir}/botryllus_pilot500_unifire.fasta"
    esmfold_weights = "${params.pilot_dir}/esmfold_params"
    esmfold_sif = "${params.pilot_dir}/containers/proteinfold_esmfold_2.0.0.sif"
    unifire_sif = "${params.pilot_dir}/containers/unifire-2026.3-lite.sif"
    // Foldseek's image and AlphaFold DB Swiss-Prot, both from `make stage`
    foldseek_sif     = "${params.pilot_dir}/containers/foldseek-9.427df8a.sif"
    foldseek_db_dir  = "${params.pilot_dir}/foldseek_db"
    foldseek_db_name = 'afdb_swissprot'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = params.pa_img_dir
    // Inputs are symlinks into $SCRATCH (data, weights); node-local temp is under /lscratch
    runOptions = "--bind ${scratch} --bind /lscratch"
}

executor {
    name              = 'slurm'
    queueSize         = 20
    submitRateLimit   = '10/1min'
    // Sherlock asks tools to wait at least 60 s between scheduler checks
    pollInterval      = '1 min'
    queueStatInterval = '2 min'
}

process {
    executor = 'slurm'
    queue    = 'hns,normal'
    // A task killed by Slurm (memory, walltime, node failure) reports Integer.MAX_VALUE.
    // One retry, then 'ignore' so the other branches still finish and give their times.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in (130..145)) && task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries = 1
    publishDir = [path: { "${params.pilot_dir}/results/${task.process.toLowerCase()}" }, mode: 'copy']
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.pilot_dir}/pipeline_info/pilot_trace.txt"
    fields    = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,cpus,memory,time,native_id'
}
