// `make run-full`: proteinannotator (InterProScan with every member database) and UniFIRE on
// all 45,339 Botryllus proteins, with each protein's own name (bin/unique_names.py).
// ESMFold and Foldseek are skipped (2026-10-28: the pilot's GPU job waited 15 h without
// starting). Sizes come from the 500-protein pilot, scaled by its residue ratio (88.8).
//
// s4pred is skipped too. It runs every protein as one task, predicted at 35 h, so with
// margin it needs more than the 2-day normal QOS: on Sherlock that means hns with its 7-day
// limit, where a 7-day job was offered a start 22 h out (2026-10-28). UniFIRE does not use
// s4pred, so it runs separately (full_pa.config holds its sizes).
def scratch = System.getenv('SCRATCH')
def full    = "${scratch}/botryllus-annotation-full"

params {
    pilot_dir = full
    fasta     = "${full}/input/botryllus_unique_names.fasta"
    fasta_ox  = "${full}/input/botryllus_unique_names_unifire.fasta"
    // The images stay where `make stage` put them for the pilot
    unifire_sif = "${scratch}/botryllus-annotation-timing-pilot/containers/unifire-2026.3-lite.sif"
    skip_fold = true
    pa_extra_args = '--skip_s4pred'
    // 500 per batch: about 91 batches of 15-55 min each (pilot: 3-11 min per 100 proteins)
    interproscan_batch_size = 500
}

process {
    // Pilot: 13 min 54 s and 24 GB peak on 499 proteins, almost all of it compiling rules.
    // The whole proteome adds about 1 h of rule matching and a 90x larger XML.
    withName: 'UNIFIRE_LITE' {
        memory = '64 GB'
        time   = '12h'
    }
}

// nextflow.config builds the trace path from the pilot's folder before this file is read
trace.file = "${full}/pipeline_info/full_trace.txt"
