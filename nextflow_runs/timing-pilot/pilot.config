// Pilot overrides on top of ../nf-core-proteinannotator/sherlock.config.
//
// The pilot splits 500 proteins into 5 InterProScan batches of 100. sherlock.config gives
// each batch 1 CPU, which is right for a 45,339-protein run spread over 46 batches but
// would leave each pilot batch running alone for many hours. 4 CPUs per batch measures
// the same work in CPU-hours either way, and the scaling script reports CPU-hours.
//
// Memory: the 10-protein Sherlock run (2026-10-25) failed before measuring anything, so
// there is no history; 16 GB is 4 GB over the full-run ask, for the JVM plus 4 workers.

//
// Data: interproscan.sh changes into its own install folder before it starts, so the
// relative `data` path in interproscan.properties reads the image's own sample data, not
// the `data` link the module makes in the task folder. The sample HMMs are not indexed and
// the image is read-only, so every batch failed in a minute (2026-10-27). Mounting the
// real data over the image's folder fixes it for every member database.

process {
    withName: '.*:INTERPROSCAN' {
        containerOptions = "--bind ${System.getenv('SCRATCH')}/botryllus-mhc-proteinannotator/dbs/interproscan-5.59-91.0/data:/usr/local/share/InterProScan/data"
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        // Exit 231: InterProScan counts its own child processes with `ps` and sometimes gets
        // nothing back (NullPointerException in getJavaCmdCount), then gives up on the batch.
        // 6 of 91 batches did this in the whole-proteome run (2026-10-28), in 14 different
        // steps (HAMAP, CATH, Pfam, Coils, ...), so it is chance, not the input: try again.
        errorStrategy = { def s = task.exitStatus
                          (s == 231 || s == null || s == Integer.MAX_VALUE || s in (130..145)) && task.attempt <= 2 ? 'retry' : 'ignore' }
    }
}
