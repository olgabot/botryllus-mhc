// `make stub`: runs main.nf's stub blocks on one compute node, to check the wiring, the
// images and the paths before a real run. Outputs go to a throwaway folder; ips_store_dir
// is moved there too so the stub's empty data folder cannot stand in for the real one.
def scratch = System.getenv('SCRATCH')
params.pilot_dir     = "${scratch}/botryllus-annotation-timing-pilot/stub-test"
params.ips_store_dir = "${scratch}/botryllus-annotation-timing-pilot/stub-test/store"
process {
    executor = 'local'
    withName: '.*' { cpus = 1; memory = '1 GB'; clusterOptions = null; queue = null }
}
// nextflow.config builds the trace path from the real pilot_dir before this file is read,
// so a stub run would overwrite the real run's trace without this line
trace.file = "${scratch}/botryllus-annotation-timing-pilot/stub-test/pipeline_info/pilot_trace.txt"
