// Whole-proteome overrides inside the nested proteinannotator run, on top of pilot.config.
//
// s4pred runs all proteins as one task. The pilot took 25 min 36 s on 11.5 CPUs and 1.3 GB
// for 500 proteins; scaled by the residue ratio (88.8) that is about 35 h, and 1.5x that
// is above the 2-day normal QOS, so it runs under the 7-day long QOS.
process {
    withName: '.*:S4PRED_RUNMODEL' {
        cpus           = 12
        memory         = '32 GB'
        time           = '56h'
        clusterOptions = '--account=ayeletv --qos=long'
    }
}
