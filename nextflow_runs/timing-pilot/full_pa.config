// s4pred on the whole proteome, for when it runs on its own (full.config skips it).
//
// s4pred runs all proteins as one task. The pilot took 25 min 36 s on 11.5 CPUs and 1.3 GB
// for 500 proteins; scaled by the residue ratio (88.8) that is about 35 h, and 1.5x that
// is above the 2-day normal QOS. Sherlock's long QOS only works on the normal partition and
// caps a user at 32 CPUs; hns allows 7 days under its own partition QOS.
process {
    withName: '.*:S4PRED_RUNMODEL' {
        queue  = 'hns'
        cpus   = 12
        memory = '32 GB'
        time   = '56h'
    }
}
