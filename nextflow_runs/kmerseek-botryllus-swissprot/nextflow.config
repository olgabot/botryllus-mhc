// kmerseek: Botryllus proteome vs UniProtKB/Swiss-Prot 2026_03, 38 alphabet-ksize pairs.
// Runs on Sherlock only (-profile sherlock); see the Makefile.

params {
    query              = null   // the renamed proteome, botryllus_unique_names.fasta
    swissprot_fasta    = null   // uniprot_sprot.fasta.gz, release 2026_03
    outdir             = 'results'
    index_dir          = 'indexes'
    pairs              = "${projectDir}/assets/pairs.tsv"
    search_resources   = "${projectDir}/assets/search_resources.tsv"
    chunk_size         = 2000

    // E-value fit at index time on this many Swiss-Prot sequences, and on this many when
    // the first fit is refused (notebooks 233-235 used 200 and 1,000).
    ka_queries         = 200
    ka_queries_retry   = 1000

    // Search filters of notebooks 232-235: a protein pair is reported when the whole-query
    // p-value is below 0.05 or the best region scores at least 1.3.
    max_query_pvalue   = 0.05
    min_region_score   = 1.3
    // Kept matches: E <= 10 with an E-value fit. Without one, region p-value below
    // 0.05 / (45,339 Botryllus x 575,748 Swiss-Prot proteins) = 1.9e-12.
    max_evalue                 = 10
    exact_max_tail_probability = 1.9e-12
    // A "strong" match in the summary tables.
    strong_cutoff      = 1e-3
}

process {
    // A task killed by SLURM (memory cgroup, walltime, node failure) reports
    // Integer.MAX_VALUE; retry once with twice the memory and time, then stop the run.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in (130..145)) && task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    sherlock {
        executor {
            name              = 'slurm'
            queueSize         = 200
            submitRateLimit   = '20/1min'
            // Sherlock asks tools to wait at least 60 s between scheduler checks
            pollInterval      = '1 min'
            queueStatInterval = '2 min'
        }
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            // kmerseek v0.4.0, built in $SCRATCH (notebooks 233-235); it needs gcc 14's libstdc++
            beforeScript   = "module load gcc/14.2.0 python/3.12.1; export PATH=${System.getenv('SCRATCH')}/301-kmerseek-v0.4.0/target/release:\$PATH"
        }
    }
    // Checks the workflow wiring without running kmerseek: make sherlock-stub
    stub {
        process.executor     = 'local'
        process.beforeScript = 'module load python/3.12.1'
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,name,tag,status,exit,submit,realtime,%cpu,peak_rss,rchar,wchar,memory,time,attempt,workdir'
}
