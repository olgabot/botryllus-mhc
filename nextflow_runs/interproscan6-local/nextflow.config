// nextflow.config for ebi-pf-team/interproscan6, local Docker execution.

docker {
    enabled = true
    // Needed on Apple Silicon (M1/M2/M3) -- interproscan6's containers are
    // amd64-only. Omit on native Linux x86_64.
    runOptions = '--platform=linux/amd64'
}

report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    { enabled = true; overwrite = true }
dag      { enabled = true; overwrite = true }
