// Sherlock (Stanford) settings for nf-core/proteinannotator.
// Used as: -profile singularity -c sherlock.config (not with nextflow.config, which turns on Docker).
//
// Compute nodes have no internet, so the head job runs with NXF_OFFLINE=true and every
// database and container is staged beforehand by `make sherlock-stage`.

def scratch = System.getenv('SCRATCH') ?: "${System.getenv('HOME')}/scratch"

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${scratch}/singularity-cache/proteinannotator"
}

executor {
    name              = 'slurm'
    queueSize         = 100
    submitRateLimit   = '10/1min'
    // Sherlock asks tools to wait at least 60 s between scheduler checks
    pollInterval      = '1 min'
    queueStatInterval = '2 min'
}

process {
    executor       = 'slurm'
    queue          = 'hns,normal'
    clusterOptions = '--account=ayeletv'

    // A task killed by SLURM (memory cgroup, walltime, node failure) reports exitStatus
    // Integer.MAX_VALUE, not 137-143, so the pipeline's own retry rule never fires for it.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in ((130..145) + 104 + (175..177))) && task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    // Sizes come from the 10-protein mini run (make sherlock-mini); see README section in the
    // Makefile for the measured numbers each one is scaled from.
    withName: '.*:INTERPROSCAN' {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        // One lost batch should not stop the other batches; a rerun with -resume redoes it.
        errorStrategy = { def s = task.exitStatus
                          (s == null || s == Integer.MAX_VALUE || s in (130..145)) && task.attempt <= 2 ? 'retry' : 'ignore' }
    }
    withName: '.*:HMMSEARCH_.*' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
}
