// nextflow.config for nf-core/proteinannotator
// Branch: olgabot/interproscan-batches (PR #79)

// Note: --platform linux/amd64 is only needed on Apple Silicon (M1/M2/M3).
// On native Linux x86_64, omit it.
docker {
    enabled = true
}

process {
    errorStrategy = 'retry'
    maxRetries = 2

    withName: '.*:INTERPROSCAN' {
        memory = '128.GB'
        cpus = 16
        time = '24.h'
        // --pid=host: InterProScan monitors child processes via `ps`. In a Docker
        // container, ps only sees the container's PID namespace by default, returning
        // null and causing NullPointerException in getJavaCmdCount() → exit 231.
        // Sharing the host PID namespace fixes this.
        // No quotes around JAVA_OPTS value — inner quotes are passed literally to JVM.
        containerOptions = '--pid=host --env JAVA_OPTS=-Xmx112G'
        errorStrategy = 'retry'
        maxRetries = 2
    }
}

report {
    enabled = true
    overwrite = true
}

timeline {
    enabled = true
    overwrite = true
}

trace {
    enabled = true
    overwrite = true
}

dag {
    enabled = true
    overwrite = true
}
