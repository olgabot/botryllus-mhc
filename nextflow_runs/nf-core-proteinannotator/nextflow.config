// nextflow.config for nf-core/proteinannotator
// Branch: olgabot/interproscan-batches (PR #79)

// Docker with Apple Silicon compatibility
docker {
    enabled = true
    runOptions = '--platform linux/amd64'
}

process {
    errorStrategy = 'retry'
    maxRetries = 2

    withName: '.*:INTERPROSCAN' {
        memory = '16.GB'
        cpus = 8
        time = '24.h'
        containerOptions = '--env JAVA_OPTS="-Xmx16G"'
        errorStrategy = 'retry'
        maxRetries = 2
    }
}

report {
    enabled = true
    overwrite = true
}

timeline {
    enabled = true
    overwrite = true
}

trace {
    enabled = true
    overwrite = true
}

dag {
    enabled = true
    overwrite = true
}
