// nextflow.config for nf-core/proteinannotator
// Branch: olgabot/interproscan-batches (PR #79)

// Note: --platform linux/amd64 is only needed on Apple Silicon (M1/M2/M3).
// On native Linux x86_64, omit it.
docker {
    enabled = true
}

process {
    errorStrategy = 'retry'
    maxRetries = 2

    withName: '.*:INTERPROSCAN' {
        memory = '64.GB'
        cpus = 16
        time = '24.h'
        // Xmx must be well below container memory limit to leave room for JVM overhead,
        // native processes, and InterProScan subprocesses — exit 231 = Java OOM
        containerOptions = '--env JAVA_OPTS="-Xmx56G"'
        errorStrategy = 'retry'
        maxRetries = 2
    }
}

report {
    enabled = true
    overwrite = true
}

timeline {
    enabled = true
    overwrite = true
}

trace {
    enabled = true
    overwrite = true
}

dag {
    enabled = true
    overwrite = true
}
